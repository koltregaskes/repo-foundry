{
  "name": "repo-foundry",
  "version": "0.1.0",
  "private": false,
  "description": "Shared internal and public hub for repository intelligence, discovery, and editorial curation under the Repo Foundry brand.",
  "type": "module",
  "scripts": {
    "sync:news": "node ./scripts/sync-release-news.mjs",
    "compile:public": "node ./scripts/compile-public-data.mjs",
    "build:public": "node ./scripts/build-public.mjs",
    "build:internal": "node ./scripts/build-internal.mjs",
    "build:all": "node ./scripts/rebuild-all.mjs",
    "test:visual": "playwright test ./tests/visual/repo-foundry.spec.js --workers=1 --browser=chromium --output=output/playwright/test-results"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
